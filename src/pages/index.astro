---

// Importa el layout principal.
//
// Este layout contiene:
// - sidebar
// - reproductor
// - estructura principal
import Layout from '../layouts/Layout.astro';


// Importa playlists desde data.ts.
import { playlists } from "../lib/data";


// Importa card visual de playlist.
import PlayListItemCard from "../components/PlayListItemCard.astro"


// Importa componente Greeting.
//
// Greeting está hecho en Svelte.
import Greeting from "../components/Greeting.svelte"


/*
    Comentarios originales de Astro.
    
    Se generan automáticamente
    cuando creás el proyecto.
*/


---



<!-- =====================================================
     LAYOUT PRINCIPAL
===================================================== -->

<Layout title="JSMusic">

    <!--
        Contenedor principal.
    -->
    <div
        id="playlist-container"

        class="
            relative
            transition-all
            duration-1000
            bg-green-600
        "
    >



        <!-- =================================================
             CONTENIDO PRINCIPAL
        ================================================= -->

        <div class="
            relative
            z-10
            px-6
            pt-10
        ">


            <!-- =============================================
                 GREETING
            ============================================== -->

            <!--
                Componente Svelte.
                
                Muestra:
                - Good Morning
                - Good Afternoon
                - Good Evening
            -->
            <Greeting/>



            <!-- =============================================
                 PLAYLISTS
            ============================================== -->

            <!--
                Contenedor de playlists.
                
                flex-wrap:
                permite múltiples filas.
            -->
            <div class="
                flex
                flex-wrap
                mt-6
                gap-4
            ">

                {
                    // Recorre playlists.
                    //
                    // Por cada playlist:
                    // renderiza una card.
                    playlists.map((playlist) => (

                        <PlayListItemCard
                            playlist={playlist}
                        />

                    ))
                }

            </div>

         </div>



         <!-- =================================================
              OVERLAY / GRADIENTE
         ================================================= -->

         <!--
            Gradiente visual de fondo.
         -->
         <div class="
            absolute
            inset-0
            bg-gradient-to-t
            from-zinc-900
            via-zinc-900/80
         "/>

    </div>

</Layout>